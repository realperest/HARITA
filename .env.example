# Coolify ortam degiskenleri (gercek degerler yalniz Coolify panelinde; bu dosya ornektir, gizli deger icermez)

# Veritabani (Coolify kaynagi harita-db, PostGIS) ve Redis (Coolify kaynagi harita-redis)
DB_SIFRE=
REDIS_SIFRE=
# Coolify'in ic ag adlari (kaynaklarin UUID'si); varsayilanlar docker-compose.yaml'da
DB_ADRESI=
REDIS_ADRESI=

# Yonetim anahtari: /yonetim/* uclari, veritabani araci ve scripts/proje-bagla.py icin (uzun rastgele)
YONETIM_ANAHTARI=

# Tarayicinin karolari cekecegi genel adres (tiles servisine atanan alan adi)
KARO_GENEL_ADRESI=https://harita-karo.ornek.com
# Tarayicidan karo / yazi tipi isteyebilecek kokenler (regex; bos birakilirsa herkes: .*)
# Mobil uygulama kabuklari icin https://localhost ve capacitor://localhost de eklenir.
IZINLI_KOKEN_REGEX=https?://([a-z0-9-]+\.)*(lezzetsepeti\.net|motoconvoy\.net|89\.45\.45\.152\.sslip\.io)|https?://localhost(:[0-9]+)?|capacitor://localhost

# Kapsam kutusu: boylam_min,enlem_min,boylam_max,enlem_max (varsayilan: tum Turkiye)
KAPSAM_KUTUSU=25.6,35.8,44.9,42.2
MAKS_YAKINLASTIRMA=15
OSM_VERI_ADRESI=https://download.geofabrik.de/europe/turkey-latest.osm.pbf
# Adres / yerlesim verisinin tazelenme araligi (gun)
GUNCELLEME_GUN=30
ROTA_IS_PARCACIGI=2
LOG_SEVIYESI=INFO
